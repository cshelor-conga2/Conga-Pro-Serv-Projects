    <description>PSC-179 - removed incorrect logic around approval required or not</description>
    <environments>Default</environments>
    <formulas>
        <name>fB_NewAgreementRequiresApproval</name>
        <dataType>Boolean</dataType>
        <expression>IF( ISNEW() &amp;&amp; 
	TEXT({!$Record.Apttus_Approval__Approval_Status__c}) != &apos;Approval Required&apos; &amp;&amp; 
	(ISPICKVAL( {!$Record.Apttus__Status_Category__c }, &apos;Request&apos; ) || ISPICKVAL( {!$Record.Apttus__Status_Category__c }, &apos;In Authoring&apos; ) || ISPICKVAL( {!$Record.Apttus__Status_Category__c }, &apos;Import&apos; ) ) &amp;&amp; 
	( TEXT({!$Record.APTS_Payment_Terms__c }) != &apos;Net 30&apos; || {!$Record.APTS_Include_Auto_Renewal_Clause__c} = false || TEXT({!$Record.APTS_Renewal_Uplift_Type__c }) != &apos;Uplift %&apos; || ( {!$Record.APTS_Renewal_Uplift_Cap__c} != NULL &amp;&amp; {!$Record.APTS_Renewal_Uplift_Cap__c} != 10) ||
	TEXT( {!$Record.CurrencyIsoCode} ) != &apos;USD&apos; || {!$Record.APTS_Expiration_Warning__c} != 45 ),
	true,
	false
)</expression>
    </formulas>
