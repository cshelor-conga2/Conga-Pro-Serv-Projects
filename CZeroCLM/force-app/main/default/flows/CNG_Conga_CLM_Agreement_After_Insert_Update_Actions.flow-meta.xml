                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.APTS_Type_of_Paper__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Conga Redlined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Apttus__Related_Opportunity__r.Amount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>250000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.APTS_Type_of_Paper__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
